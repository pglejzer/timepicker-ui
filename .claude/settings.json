{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(npm publish*)",
      "Bash(npm unpublish*)",
      "Bash(npm deprecate*)",
      "Bash(npm dist-tag*)",
      "Bash(npm version*)",
      "Bash(npm login*)",
      "Bash(npm logout*)",
      "Bash(npm adduser*)",
      "Bash(npm token*)",
      "Bash(npm owner*)",
      "Bash(npm access*)",
      "Bash(npm install*)",
      "Bash(npm i)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm ci*)",
      "Bash(npm uninstall*)",
      "Bash(npm remove *)",
      "Bash(npm rm *)",
      "Bash(npm update*)",
      "Bash(npm up)",
      "Bash(npm up *)",
      "Bash(npm audit fix*)",
      "Bash(npm link*)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",
      "Bash(pnpm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm i *)",
      "Bash(pnpm publish*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm update*)",
      "Bash(pnpm dlx*)",
      "Bash(yarn add*)",
      "Bash(yarn install*)",
      "Bash(yarn publish*)",
      "Bash(yarn remove*)",
      "Bash(yarn upgrade*)",
      "Bash(yarn dlx*)",
      "Bash(bun add*)",
      "Bash(bun install*)",
      "Bash(bun publish*)",
      "Bash(bun remove*)",
      "Bash(bun update*)",
      "Bash(bunx*)",
      "Bash(git push*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo fork*)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(vercel*)",
      "Bash(netlify*)",
      "PowerShell(npm publish*)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm ci*)",
      "PowerShell(npm uninstall*)",
      "PowerShell(npm update*)",
      "PowerShell(npm version*)",
      "PowerShell(git push*)",
      "PowerShell(gh release create*)",
      "PowerShell(vercel*)",
      "Edit(/dist/**)",
      "Write(/dist/**)",
      "Edit(**/node_modules/**)",
      "Write(**/node_modules/**)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash)",
      "Bash(git stash push *)",
      "Bash(git stash pop*)",
      "Bash(git stash drop*)",
      "Bash(git stash apply*)",
      "Bash(git clean *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git pull*)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout *)",
      "PowerShell(git reset *)",
      "PowerShell(git stash*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
