{
  "name": "timepicker-ui-build",
  "version": "1.0.0",
  "main": "../dist/index.umd.js",
  "module": "../dist/index.js",
  "types": "../dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.js"
    },
    "./plugins/range": {
      "types": "./dist/plugins/range.d.ts",
      "import": "./dist/plugins/range.js",
      "require": "./dist/plugins/range.umd.js"
    },
    "./plugins/timezone": {
      "types": "./dist/plugins/timezone.d.ts",
      "import": "./dist/plugins/timezone.js",
      "require": "./dist/plugins/timezone.umd.js"
    },
    "./plugins/wheel": {
      "types": "./dist/plugins/wheel.d.ts",
      "import": "./dist/plugins/wheel.js",
      "require": "./dist/plugins/wheel.umd.js"
    }
  },
  "type": "module",
  "sideEffects": [
    "docs/**"
  ],
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build:js": "node -e \"require('fs').rmSync('../dist',{recursive:true,force:true})\" && tsdown",
    "build:css": "sass --no-source-map --style=compressed src/styles/index.scss:../dist/css/index.css src/styles/main.scss:../dist/css/main.css src/styles/themes:../dist/css/themes",
    "build:prod": "npm run eslint && npm run build:js && npm run build:css",
    "build:demo": "vite build",
    "build:vercel": "vite build",
    "start": "vite",
    "lint": "lint-staged && pretty-quick --staged",
    "eslint": "eslint ./src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "author": "pglejzer",
  "license": "MIT",
  "homepage": "https://github.com/pglejzer/timepicker-ui#readme",
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.10",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "eslint-config-eslint": "^11.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-tree-shaking": "^1.12.2",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "sass": "1.89.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.1",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.4"
  }
}
